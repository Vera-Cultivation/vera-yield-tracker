# Copy to .env and fill in. Both values are in
# Supabase Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Only for `npm run schema` (writes supabase/schema.json). Server-side secret:
# never prefix it with VITE_, or it ends up in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: wholesale price used for revenue (default 3.6 $/g).
# VITE_PRICE_PER_GRAM=3.6
